{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build and run AR&MF",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/aramf.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "preLaunchTask": "CMake: Build AR&MF",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
