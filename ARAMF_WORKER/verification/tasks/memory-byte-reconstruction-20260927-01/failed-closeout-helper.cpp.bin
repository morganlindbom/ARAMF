#include "core/ProjectModel.h"
#include "core/ProjectPersistence.h"
#include "core/Services.h"
#include "core/CertificationFreshness.h"
#include "core/CertificationRevalidation.h"
#include "core/FoundationCertificationCampaign.h"
#include "core/WorkerTaskServices.h"
#include "core/ProjectMemory.h"
#include <QCoreApplication>
#include <QCryptographicHash>
#include <QDateTime>
#include <QDirIterator>
#include <QFile>
#include <QFileInfo>
#include <QJsonDocument>
#include <QProcess>
#include <QSaveFile>
#include <QTextStream>
#include <QUuid>

QByteArray bytes(const QString& path) { QFile f(path); return f.open(QIODevice::ReadOnly) ? f.readAll() : QByteArray{}; }
QString hash(const QByteArray& data) { return QString::fromLatin1(QCryptographicHash::hash(data,QCryptographicHash::Sha256).toHex()); }
QJsonObject read(const QString& path) { return QJsonDocument::fromJson(bytes(path)).object(); }
bool writeNew(const QString& path,const QByteArray& data) {
 if(QFileInfo::exists(path)) return false;
 QDir().mkpath(QFileInfo(path).absolutePath()); QSaveFile f(path);
 return f.open(QIODevice::WriteOnly)&&f.write(data)==data.size()&&f.commit()&&bytes(path)==data;
}
QByteArray git(const QStringList& args) {
 QProcess p; p.start("git",args); if(!p.waitForFinished(30000)||p.exitCode()!=0) return {};
 return p.readAllStandardOutput();
}
const QStringList subjects{"F1","F2","F3","F4","S1","S2","S3","S4","S5","S6","P1","P2","P3","P4","P5"};
QJsonObject protectedState() {
 QJsonObject files; const QDir root(QDir::currentPath());
 files.insert("LICENSE",hash(bytes("LICENSE")));
 for(const auto& directory:QStringList{"test_250/runs","test_550/runs","D:/ON DESCTOP/HKR KURSER/C++/C++Summer 2026 Project7/Components"}) {
  if(!QFileInfo(directory).isDir()) return {};
  QDirIterator it(directory,QDir::Files|QDir::Hidden|QDir::System,QDirIterator::Subdirectories);
  while(it.hasNext()) {const auto path=it.next(); if(QFileInfo(path).isSymLink()) return {}; files.insert(root.relativeFilePath(QFileInfo(path).absoluteFilePath()),hash(bytes(path)));}
 }
 return {{"files",files},{"componentsEmpty",QDir("D:/ON DESCTOP/HKR KURSER/C++/C++Summer 2026 Project7/Components").entryList(QDir::AllEntries|QDir::NoDotAndDotDot|QDir::Hidden|QDir::System).isEmpty()},{"gitStatus",QString::fromUtf8(git({"status","--short","--","LICENSE","test_250/runs/","test_550/runs/"}))},
  {"staged",QString::fromUtf8(git({"diff","--cached","--name-only","--","LICENSE","test_250/runs/","test_550/runs/"}))}};
}
QJsonObject inputs() {
 QJsonObject result;
 for(const auto& p:QString::fromUtf8(git({"ls-files","--cached","--others","--exclude-standard","--","src","tests","CMakeLists.txt","test_250/runner/main.cpp","test_550/runner/main.cpp","test_update/runner/main.cpp"})).split('\n',Qt::SkipEmptyParts)) result.insert(p,hash(bytes(p)));
 return result;
}
QJsonObject sourceHashes() {
 QJsonObject result; for(const auto& s:subjects){QString h,e;if(!CertificationSourceManifestProvider::fingerprint(QDir::currentPath(),s,&h,&e))return {};result.insert(s,h);} return result;
}
bool reportValid(const QString& path) {
 const auto report=read(path); if(report.value("status")!="PASS"||report.value("validationInputs").toObject()!=inputs()||report.value("sourceFingerprints").toObject()!=sourceHashes())return false;
 for(const auto& v:report.value("checks").toArray()){const auto c=v.toObject();if(c.value("status")!="PASS"||c.value("fingerprint")!=hash(bytes(c.value("reference").toString())))return false;}
 return true;
}

int main(int argc,char** argv) {
 QCoreApplication app(argc,argv); const auto args=app.arguments(); const QString mode=args.value(1),root=QDir::currentPath(); QString error;
 const QString baseline="build/named-worker-protected.json";
 ProjectModel model; if(!ProjectPersistence().load(&model,"ARAMF_WORKER.aramf.json",&error))return 1;
 if(mode=="protect")return writeNew(baseline,QJsonDocument(protectedState()).toJson())?0:2;
 if(mode=="freshness"){
  bool all=true;for(const auto& s:subjects){const auto f=CertificationFreshnessService::evaluate(s,root);all&=f.status==CertificationFreshnessStatus::Fresh;QTextStream(stdout)<<s<<" "<<certificationFreshnessStatusName(f.status)<<Qt::endl;}return all?0:3;
 }
 if(mode=="postflight"){
  const auto c=read("build/named-worker-contract.json").value("contract").toObject();
  QTextStream(stdout)<<QJsonDocument(WorkerTaskServices::postflight(model,c)).toJson();return 0;
 }
 if(mode=="run"){
  if(protectedState()!=read(baseline))return 4;
  const QString id=QUuid::createUuid().toString(QUuid::WithoutBraces),area="ARAMF_WORKER/verification/tasks/named-worker-update/"+id;
  const QString fixtures=root+"/build/named-worker-regression-"+id;QDir().mkpath(fixtures);
  const auto before=inputs(),fingerprints=sourceHashes();QJsonArray checks;bool all=!before.isEmpty()&&!fingerprints.isEmpty();
  auto run=[&](const QString& name,const QString& program,const QStringList& arguments,const QString& cwd){
   QTextStream(stdout)<<"RUN "<<name<<Qt::endl;QProcess p;p.setWorkingDirectory(cwd);p.setProcessChannelMode(QProcess::MergedChannels);p.start(program,arguments);
   bool finished=p.waitForFinished(3600000);if(!finished){p.kill();p.waitForFinished();}const int code=finished&&p.exitStatus()==QProcess::NormalExit?p.exitCode():-1;
   const auto log=p.readAllStandardOutput();const QString path=area+"/"+name+".log.json";
   const auto sealed=QJsonDocument(QJsonObject{{"encoding","base64"},{"rawSha256",hash(log)},{"rawByteCount",log.size()},{"data",QString::fromLatin1(log.toBase64())}}).toJson();
   const bool saved=writeNew(path,sealed);all&=code==0&&saved;checks.append(QJsonObject{{"name",name},{"program",program},{"arguments",QJsonArray::fromStringList(arguments)},{"cwd",cwd},{"exitCode",code},{"status",code==0&&saved?"PASS":"FAIL"},{"reference",path},{"fingerprint",hash(sealed)}});
   QTextStream(stdout)<<name<<": "<<code<<" "<<path<<Qt::endl;
  };
  run("production-build","cmake",{"--build","build","-j","6"},root);
  run("named-worker-updates",root+"/build/aramf_configuration_update_tests.exe",{},fixtures);
  run("identity",root+"/build/aramf_template_tests.exe",{"--identity"},fixtures);
  run("ctest","ctest",{"--test-dir","build","--output-on-failure","-j","2"},root);
  run("test-250",root+"/build/aramf_campaign_runner.exe",{},fixtures);
  run("test-550-automated",root+"/build/aramf_release_validation_runner.exe",{},fixtures);
  run("application-startup",root+"/build/foundation-startup-probe.exe",{},fixtures);
  run("memory-consistency",root+"/build/aramf.exe",{"memory","validate","--project",root},root);
  run("cold-start",root+"/build/aramf.exe",{"memory","cold-start","--project",root},root);
  run("git-diff-check","git",{"diff","--check"},root);
  all&=before==inputs()&&fingerprints==sourceHashes()&&protectedState()==read(baseline);
  QJsonObject report{{"status",all?"PASS":"FAIL"},{"validationInputs",before},{"sourceFingerprints",fingerprints},{"checks",checks},{"fixtures",fixtures},{"protectedUnchanged",protectedState()==read(baseline)},
   {"earlierAttempts",QJsonArray{"New template regression initially used nonexistent qt-desktop ID; corrected to canonical qt-desktop-application.",
    "New removal regression initially interpreted success as execution; existing service returns successful validation with removalBlocked=true. Correct assertion retains existing deletion protection.",
    "Focused template fixture created under root was preserved and moved to ignored build directory; no content deleted.",
    "First full attempt interrupted (-1073741510); evidence preserved. Second CTest run: 17/18 PASS; newly added reusable-template check incorrectly inspected normalized defaults instead of persisted bytes. Corrected test checks persisted absence plus independent reload and application; focused identity now 60/60 PASS."}},
   {"timestamp",QDateTime::currentDateTimeUtc().toString(Qt::ISODateWithMs)},{"freshness",FoundationCertificationCampaign::freshness(root)}};
  const QString path=area+"/regression.json";if(!writeNew(path,QJsonDocument(report).toJson()))return 5;
  QTextStream(stdout)<<"REPORT "<<path<<Qt::endl;return all?0:6;
 }
 if(mode=="finish"){
  const QString path=args.value(2),area=QFileInfo(path).path();
  if(!reportValid(path)||protectedState()!=read(baseline))return 7;
  for(const auto&s:subjects)if(CertificationFreshnessService::evaluate(s,root).status!=CertificationFreshnessStatus::Fresh)return 8;
  const auto original=read("build/named-worker-contract.json").value("contract").toObject();
  const auto old=original.value("baseline").toObject();
  for(const auto& p:old.keys())if(p.startsWith("ARAMF_WORKER/certification/")&&!p.contains("/current-")&&hash(bytes(p))!=old.value(p))return 9;
  const auto oldProject=QJsonDocument::fromJson(git({"show","cb4ba92048c30a3fd8a5c41014dbfab0d54d3a12:ARAMF_WORKER.aramf.json"})).object();
  if(processVersionStateToJson(model.processVersionState())!=oldProject.value("processVersion").toObject())return 10;
  ProjectMemory memory;const QJsonObject prov{{"actor","agent"},{"agentId","codex"},{"tool","aramf-production-services"}};
  QJsonObject fields{{"task","named-worker-update"},{"scope","source-code"},{"provenance",prov},{"status","FAIL"},{"summary","Retained early failed assertions: nonexistent template ID, removalBlocked interpretation and checking normalized defaults instead of persisted template bytes. First full attempt interrupted; second CTest 17/18; third CTest 17/18 because new custom fixture polluted the existing built-in catalog. Isolated the new template library instead of changing existing expectations. Historical attempt logs preserved; no deletion guard weakened."}};
  if(!memory.recordOperation(root,"validation-result",fields,nullptr,&error))return 11;
  for(const auto&v:read(path).value("checks").toArray()){const auto c=v.toObject();fields.insert("status",c.value("status"));fields.insert("summary",c.value("name").toString()+": "+c.value("status").toString());fields.insert("detail",c.value("reference"));fields.insert("evidenceFingerprint",c.value("fingerprint"));
   if(!memory.recordOperation(root,c.value("name").toString().contains("build")?"build-result":"test-result",fields,nullptr,&error))return 12;}
  if(!memory.recordDecision(root,"named-worker-configuration-identity","project-worker-identity",
   "Named worker configuration updates resolve the exact persisted ARAMF_WORKER_<suffix> identity and project UUID/root; never select a prefix-matching sibling. Template changes preserve worker suffix; reusable templates exclude worker instance identity. Legacy unsuffixed workers remain supported. No P6, source relocation or HVD target changes.",
   "current",{},&error,prov,"project"))return 13;
  if(!GenerationServices().generate(model,model.generationOptions()).success)return 14;
  const auto verification=VerificationServices().verify(model,model.generationOptions());if(verification.overallStatus!=VerificationStatus::Pass)return 15;
  // Preserve the execution contract and its raw postflight. Raw sealed logs
  // are not task-check records, so the existing protocol requires a separate
  // validation contract after recording them, not a rewrite of the original.
  const auto originalPostflight=WorkerTaskServices::postflight(model,original);
  if(!writeNew(area+"/implementation-contract.json",QJsonDocument(QJsonObject{{"contract",original}}).toJson())
   ||!writeNew(area+"/implementation-postflight.json",QJsonDocument(originalPostflight).toJson()))return 16;
  const QStringList exact{"src/core/ConfigurationUpdateService.cpp","src/core/TemplateManager.cpp","tests/ConfigurationUpdateTests.cpp","tests/TemplateConfigurationTests.cpp"};
  for(const auto&p:exact)if(!original.value("permittedFiles").toArray().contains(p))return 22;
  for(const auto&p:QString::fromUtf8(git({"diff","--name-only","--","src","tests","CMakeLists.txt"})).split('\n',Qt::SkipEmptyParts))if(!exact.contains(p))return 23;
  WorkerTaskRequest request;request.type="governance";request.scopes={"source-code","tests"};request.files=exact;request.history=true;
  request.goal="Validate named-worker repair against original READY scope and sealed regression; no further implementation";
  request.definitionOfDone={"Original exact implementation authorization audited","Full routed regression passes","All certified subjects remain fresh","Protected target and user files unchanged","No source migration or P6"};
  const auto contract=WorkerTaskServices::prepare(model,request);
  if(!contract.value("preflight").toObject().value("status").toString().startsWith("READY")){QTextStream(stdout)<<QJsonDocument(contract).toJson();return 24;}
  const auto observation=WorkerTaskServices::postflight(model,contract);
  if(!writeNew(area+"/contract.json",QJsonDocument(QJsonObject{{"contract",contract}}).toJson()))return 16;
  QJsonArray entries;
  for(const auto&v:contract.value("requiredEvidence").toArray()){
   const auto name=v.toString();if(name=="diff-boundary")continue;
   const QJsonObject proof{{"check",name},{"contractId",contract.value("contractId")},{"resultFingerprint",observation.value("resultFingerprint")},{"status","PASS"},{"regressionArtifact",path},{"regressionFingerprint",hash(bytes(path))},{"verification",verification.summary},{"freshness",FoundationCertificationCampaign::freshness(root)},{"protectedUnchanged",true},{"lifecycleUnchanged",true},{"historicalCertificationUnchanged",true},{"implementationContractArtifact",area+"/implementation-contract.json"},{"implementationContractFingerprint",hash(bytes(area+"/implementation-contract.json"))}};
   const auto data=QJsonDocument(proof).toJson();const QString artifact=area+"/"+QString(name).replace(':','_').replace('/','_')+".json";if(!writeNew(artifact,data))return 17;
   entries.append(QJsonObject{{"check",name},{"artifact",artifact},{"artifactFingerprint",hash(data)}});
  }
  const auto final=WorkerTaskServices::postflight(model,contract,entries);
  if(!writeNew(area+"/postflight.json",QJsonDocument(final).toJson()))return 18;
  QTextStream(stdout)<<QJsonDocument(final).toJson();
  if(final.value("completionState")!="VERIFIED")return 19;
  fields.insert("status","PASS");fields.insert("summary","Implemented and verified exact named-worker selection, suffix persistence through templates, legacy compatibility and project isolation. Full routed regression PASS; F1-F4/P1-P5/S1-S6 FRESH. KNOWN BLOCKER: isolated HVD C++/Qt6 configuration preview found pre-existing partial update propagation: rules, platform metadata and resources remain old despite update PASS. Real HVD target unchanged; requires separate product repair before applying settings. No P6 or source migration.");
  fields.insert("detail",area+"/postflight.json");if(!memory.recordOperation(root,"task-complete",fields,nullptr,&error))return 20;
  if(!GenerationServices().generate(model,model.generationOptions()).success
   ||VerificationServices().verify(model,model.generationOptions()).overallStatus!=VerificationStatus::Pass)return 25;
  const auto finalPostflight=WorkerTaskServices::postflight(model,contract,entries);
  if(!writeNew(area+"/final-postflight.json",QJsonDocument(finalPostflight).toJson())||finalPostflight.value("completionState")!="VERIFIED")return 26;
  if(protectedState()!=read(baseline))return 21;
  return 0;
 }
 return 99;
}
