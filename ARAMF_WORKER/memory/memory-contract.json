{
    "_file": "memory-contract.json",
    "arguments": {
        "optional": [
            "--status",
            "--summary",
            "--detail",
            "--category",
            "--issue",
            "--build-system",
            "--configuration",
            "--suite",
            "--passed",
            "--failed",
            "--total"
        ],
        "required": [
            "--project",
            "--operation",
            "--task"
        ]
    },
    "checkpointOperation": {
        "command": "aramf memory checkpoint --project <project-root> --title <title> --summary <summary> [--task <task>] [--commit <sha>] [--verification-status <status>]",
        "configuredOption": "record-checkpoints",
        "deliberate": true,
        "optional": [
            "--task",
            "--commit",
            "--verification-status"
        ],
        "required": [
            "--project",
            "--title",
            "--summary"
        ]
    },
    "command": {
        "executable": "aramf",
        "projectArgument": "--project <project-root>",
        "syntax": "aramf memory record --project <project-root> --operation <operation> ..."
    },
    "configuredMaintenanceOptions": [
        "update-current-state",
        "record-decisions",
        "record-checkpoints",
        "record-validation",
        "record-build-results",
        "record-test-results",
        "record-task-completion",
        "update-project-status",
        "remove-stale-state",
        "preserve-append-only"
    ],
    "directEditing": "forbidden: use the ARAMF memory recorder; do not edit owned files directly.",
    "frameworkKnowledgeLibrary": {
        "globalLocation": "AramfPaths::programRoot()/ARAMF_DATA/framework-knowledge-library.json",
        "layers": [
            "built-in product knowledge",
            "global user-approved portable knowledge",
            "project-local knowledge"
        ],
        "legacyMigration": "Legacy AppData and executable-local ARAMF_DATA libraries are merged once into root ARAMF_DATA; legacy files are retained as non-authoritative recovery evidence and are never used as fallbacks.",
        "promotionCommand": "aramf memory knowledge promote --project <project-root> --id <knowledge-id>",
        "promotionPolicy": "Only explicitly approved portable entries may be promoted; direct editing of the global library and project framework-knowledge.json is forbidden.",
        "seeding": "New managed projects seed approved global and built-in knowledge without replacing project-local entries."
    },
    "improvementBacklog": {
        "directEditing": "forbidden",
        "listCommand": "aramf improvement list --project <project-root> [--stage <stage>] [--status <status>]",
        "observationOnly": true,
        "path": "AramfPaths::programRoot()/ARAMF_DATA/aramf-improvement-backlog.json",
        "reportCommand": "aramf improvement report --project <project-root> --title <title> --observation <observation> [--expected <behavior>] [--area <area>] [--evidence <evidence>]",
        "triageCommand": "aramf improvement triage --project <project-root> --id <gap-id> --action <promote|project-specific|duplicate|needs-evidence|already-resolved|reject> [--duplicate-of <gap-id>] [--priority <priority>]"
    },
    "ownedFiles": [
        "memory/event-log.jsonl",
        "memory/metrics.json",
        "memory/current-state.md",
        "memory/memory-manifest.json",
        "memory/memory-consistency-validation.json",
        "PROJECT_STATUS.md"
    ],
    "recordingEnabled": true,
    "separateOperations": {
        "checkpoints": "deliberate stable recovery points; use aramf memory checkpoint --project <project-root> --title <title> --summary <summary>; not created by routine feedback",
        "durableDecisions": "deliberate architecture/policy records through the decision workflow"
    },
    "supportedOperations": [
        "task-start",
        "task-complete",
        "build-result",
        "test-result",
        "validation-result"
    ],
    "version": 1
}
