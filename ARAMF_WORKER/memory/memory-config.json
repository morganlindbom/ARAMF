{
    "_file": "memory-config.json",
    "captureCategories": [
        "current-project-status",
        "project-capabilities",
        "durable-decisions",
        "completed-tasks",
        "corrective-actions",
        "validation-results",
        "checkpoints",
        "certification-knowledge",
        "current-workflow-state",
        "selected-template",
        "current-build-state",
        "current-test-state",
        "current-verification-state",
        "architecture-decisions",
        "tooling-decisions",
        "dependency-decisions",
        "resource-decisions",
        "ai-configuration-decisions",
        "user-approved-exceptions",
        "failed-attempts",
        "build-attempts",
        "test-attempts",
        "reusable-project-knowledge",
        "source-references",
        "learned-constraints",
        "known-limitations",
        "known-workarounds"
    ],
    "compactionPolicy": "verified-compaction-only",
    "compactionReviewThreshold": 500,
    "historyOptions": [
        "event-history",
        "decision-history",
        "validation-history",
        "task-history",
        "failure-history",
        "milestone-history"
    ],
    "legacyProvenanceCutoffSequence": 311,
    "maintenanceOptions": [
        "update-current-state",
        "record-decisions",
        "record-checkpoints",
        "record-validation",
        "record-build-results",
        "record-test-results",
        "record-task-completion",
        "update-project-status",
        "remove-stale-state",
        "preserve-append-only"
    ],
    "maximumSizeBytes": 10737418240,
    "retentionLevel": "standard",
    "updateStrategy": "meaningful-task",
    "validationOptions": [
        "memory-consistency",
        "cold-start-validation",
        "sequence-continuity",
        "conflicting-decisions",
        "stale-current-state",
        "referenced-resources",
        "project-status-consistency",
        "event-provenance-valid",
        "persisted-scope-validity"
    ],
    "writerMode": "agent-direct"
}
