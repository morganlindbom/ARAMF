{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-ucrt64",
      "displayName": "Windows MSYS2 UCRT64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-ucrt64-debug",
      "configurePreset": "windows-ucrt64"
    }
  ]
}
